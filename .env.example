VITE_GATEWAY_URL=http://localhost:8080
# Keep the development proxy enabled for same-origin local development.
VITE_GATEWAY_PROXY=true
# Opt-in draft UI. Also enable GATEWAY_STUDIO_ENABLED on the API server.
VITE_STUDIO_ENABLED=false
# Optional full-bleed home film and reduced-motion poster. Empty = CSS stars.
# Use a root-relative asset path or HTTPS URL. These are Vite build-time values.
VITE_HOME_VIDEO_URL=
VITE_HOME_POSTER_URL=
